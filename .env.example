# Achichiz API — environment template.
#
# Copy to `.env` and fill in real values. NEVER commit the filled copy: `.gitignore` already
# blocks `.env` and `.env.*`, and this file is the only one meant to be tracked.
#
# There is deliberately no example value on any secret line. A "sample" secret gets copied into
# production more often than it gets replaced.

# ─────────────────────────────────────────────────────────────── REQUIRED
# The app refuses to boot without these five.

# postgres://USER:PASSWORD@HOST:5432/DATABASE
# Local development should point at localhost. Pointing a dev machine at the Lightsail RDS host
# means every test writes to production — that has already happened once.
DATABASE_URL=

# redis://localhost:6379 locally. Required: rate limiting, idempotency keys, cart/session
# caching and the BullMQ queues all sit on it. `/readyz` reports 503 while it is unreachable.
REDIS_URL=

# Independent random strings, at least 32 bytes each. Rotating either invalidates every live
# session for that audience, which is the intended behaviour after any suspected exposure.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_CUSTOMER_SECRET=
JWT_STAFF_SECRET=

# `true` in production. Gates /docs/admin behind staff auth — the admin spec lists every refund
# and export endpoint, so an open copy is a free attack map.
DOCS_ADMIN_REQUIRE_AUTH=true

# ─────────────────────────────────────────────────────────────── SERVER
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:4000

# Comma-separated. The storefront and admin origins must both be listed or the browser blocks
# every call. Include the port: `localhost:3000` and `127.0.0.1:3000` are different origins.
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────── DATABASE
DATABASE_POOL_MAX=10
# DATABASE_READONLY_URL=
# DATABASE_CA_CERT=

# ─────────────────────────────────────────────────────────────── TOKENS
JWT_CUSTOMER_TTL=15m
JWT_STAFF_TTL=10m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=achichiz-api

# ─────────────────────────────────────────────────────────────── RAZORPAY
# A `rzp_live_` key is REFUSED unless NODE_ENV=production — the guard is deliberate, do not
# work around it. Use `rzp_test_` everywhere else.
#
# Without RAZORPAY_WEBHOOK_SECRET the customer is charged and the order never becomes paid, so
# boot fails on a half-configured gateway rather than taking money it cannot reconcile.
# Verify with: npm run razorpay:preflight
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────── FIREBASE
# Staff and customer passwords live in Firebase Auth — `staff_users.password_hash` is only a
# marker and is never consulted.
#
# The service-account key is a BIND-MOUNTED FILE at /app/serviceAccountKey.json (see
# docker-compose.prod.yml), never an env var: editing it here re-exposes it, and baking it into
# the image leaves it readable in every layer. Only the public API key belongs in this file.
FIREBASE_API_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# ─────────────────────────────────────────────────────────────── GOOGLE
# Server-side geocoding for `GET /v1/geo/reverse`. This must be a DIFFERENT key from the one the
# storefront ships: a browser key is HTTP-referrer restricted, and Google rejects those for the
# Geocoding API with "API keys with referer restrictions cannot be used with this API".
# Restrict this one by IP to the API host, and enable the Geocoding API on it.
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────── AWS / S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=Achichiz <connect@achiachi.in>

S3_BUCKET=achichiz-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────────── DOCS
# Comma-separated CIDRs. Combined with DOCS_ADMIN_REQUIRE_AUTH above.
# DOCS_ADMIN_IP_ALLOWLIST=

# ─────────────────────────────────────────────────────────────── COMMERCE
# Integer paise. Never rupees, never floats.
FREE_SHIPPING_THRESHOLD_PAISE=99900
SHIPPING_FEE_PAISE=14900
